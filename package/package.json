    "pino": "^8.19.0",
    "rebrowser-playwright-core": "^1.49.1",
    "user-agents": "^1.1.156",
    "yn": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/user-agents": "^1.0.4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
